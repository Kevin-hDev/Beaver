    "lint": "node scripts/check-react-component-calls.mjs && eslint src/",
    "lint:react-boundaries": "node scripts/check-react-component-calls.mjs",
    "test": "vitest run && npm run test:build-scripts && npm run test:ci-scripts && npm run test:cef && npm run test:e2e-runner && npm run test:extensions-host",
    "test:build-scripts": "node --test scripts/build/*.test.mjs",
    "test:ci-scripts": "node --test scripts/ci/*.test.mjs",
    "test:searxng-scripts": "node scripts/ci/run-searxng-python-tests.mjs",
    "test:brand-boundaries": "node --test scripts/brand/brand-boundaries.test.mjs scripts/brand/brand-boundaries-unit.test.mjs scripts/brand/brand-boundaries-repository.test.mjs",
    "test:bridge-release": "node --test scripts/release/check-bridge-metadata.test.mjs scripts/release/publish-bridge-release.test.mjs",
    "test:release-workflow": "node --test scripts/release/app-version-contract.test.mjs scripts/release/check-brand-artifacts.test.mjs scripts/release/resolve-artifact-path.test.mjs scripts/release/tauri-version-contract.test.mjs scripts/release/text-contracts.test.mjs scripts/release/release-workflow.test.mjs",
    "test:update-manifest": "node --test scripts/release/create-update-manifest.test.mjs",
    "test:package-migration": "node --test scripts/release/package-migration.test.mjs",
    "test:persistence-migration": "node --test scripts/migration/persistence-baseline.test.mjs scripts/migration/persistence-profile.test.mjs scripts/migration/persistence-roots.test.mjs",
    "test:cef": "node --test scripts/cef/cef-extract.test.mjs scripts/cef/cef-supervision-contracts.test.mjs scripts/cef/macos-runtime-profile.test.mjs scripts/cef/tauri-bundle-marker.test.mjs scripts/cef/tauri-bundle-request.test.mjs scripts/cef/windows-sha256.test.mjs",
    "test:extensions-host": "node scripts/extensions/prepare-extension-host.mjs --dev && node --test scripts/extensions/*.test.mjs",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:e2e:packaged": "node scripts/e2e/run-packaged.mjs",
    "test:e2e-runner": "node --test scripts/e2e/*.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:install": "bash scripts/test-install-sh.sh && node --test scripts/installers-security.test.mjs && npm run test:package-migration",
    "test:provider-usage": "node scripts/check-provider-usage.mjs",
    "test:j3-native-assets": "node --test scripts/ollama/verify-native-upgrade-assets.test.mjs scripts/ollama/native-upgrade-proof.test.mjs",
    "test:ollama-manager-contracts": "node --test scripts/ollama/ollama-manager-contracts.test.mjs && node scripts/ollama/ollama-manager-contracts.mjs",
    "contracts:generate": "cd src-tauri && cargo test models::provider_contract_tests::export_typescript_provider_contract -- --ignored --exact --nocapture",
    "contracts:generate:ollama": "cd src-tauri && cargo test services::ollama_manager::typescript_contract_tests::export_typescript_runtime_contract -- --ignored --exact --nocapture",
    "contracts:check": "cd src-tauri && cargo test models::provider_contract_tests::checked_in_typescript_matches_the_rust_contract -- --exact",
    "forecast:lock-runtimes": "bash scripts/forecast/lock-runtimes.sh",
    "test:watch": "vitest"
  },
