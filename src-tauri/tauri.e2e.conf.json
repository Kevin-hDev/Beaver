{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.clgo.dash.e2e",
  "build": {
    "beforeBuildCommand": "node scripts/e2e/prepare-build.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default",
        "forecast-workbench",
        "forecast-docs",
        "mascot",
        {
          "identifier": "e2e-wdio",
          "description": "WebDriver bridge reserved for the isolated E2E build",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  },
  "bundle": {
    "resources": ["default-skills/**/*"],
    "macOS": {
      "frameworks": [
        "target/e2e/cef-runtime/macos/Chromium Embedded Framework.framework"
      ],
      "files": {
        "Frameworks": "target/e2e/cef-runtime/macos/helpers",
        "Resources/cef/LICENSE.txt": "target/e2e/cef-runtime/macos/LICENSE.txt"
      }
    }
  }
}
