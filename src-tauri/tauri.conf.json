{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beaver",
  "version": "1.1.1",
  "identifier": "com.clgo.dash",
  "build": {
    "beforeDevCommand": "node scripts/extensions/prepare-extension-host.mjs --dev && node scripts/cef/prepare-cef-source.mjs && npm run dev",
    "beforeBuildCommand": "node scripts/build/prepare-release.mjs",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Beaver",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "default-skills/**/*",
      "resources/forecast-sidecar/server.py",
      "resources/forecast-sidecar/test_model_smoke.py",
      "resources/forecast-sidecar/requirements.txt",
      "resources/forecast-sidecar/forecast_runtime/**/*",
      "resources/extension-host/**/*",
      "resources/searxng-sidecar/**/*",
      "target/updater-helper/*"
    ],
    "linux": {
      "deb": {
        "provides": ["cl-go"],
        "conflicts": ["cl-go"],
        "replaces": ["cl-go"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "frameworks": [
        "target/cef-runtime/macos/Chromium Embedded Framework.framework"
      ],
      "files": {
        "Frameworks": "target/cef-runtime/macos/helpers",
        "Resources/cef/LICENSE.txt": "target/cef-runtime/macos/LICENSE.txt"
      }
    }
  }
}
