  "transport": {
    "contextEnvelopeField": "__beaverContext",
    "interceptorContributionField": "interceptors"
  },
  "events": [
    "session.turn.started",
    "session.turn.completed",
    "session.turn.failed",
    "session.turn.cancelled",
    "tool.execution.started",
    "tool.execution.finished",
    "automation.execution.started",
    "automation.execution.finished",
    "subagent.status.changed"
  ],
  "hostStates": ["stopped", "starting", "running", "error"],
  "loadStages": ["import", "activate", "register"],
  "effectClasses": [
    "read-only",
    "local-write",
    "external-read",
    "external-write",
    "process",
    "secret",
    "unknown"
  ],
  "limits": {
    "maxExtensions": 132,
    "maxUserExtensions": 128,
    "maxTools": 256,
    "maxToolsPerExtension": 64,
    "maxEventsPerExtension": 64,
    "maxExtensionNameChars": 100,
    "maxExtensionTextChars": 2000,
    "maxSkillsPerExtension": 32,
    "maxResourcesPerExtension": 64,
    "maxResultBlocks": 16,
    "maxResultFiles": 8,
    "maxResultTextBytes": 524288,
