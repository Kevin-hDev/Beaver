        "result": "automation"
      },
      {
        "name": "automations.delete",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "automations",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["local-write", "process"],
        "params": [
          {
            "name": "automationId",
            "type": "string",
            "required": true,
            "limit": "maxIdentifierChars"
          },
          { "name": "revision", "type": "integer", "required": true }
        ],
