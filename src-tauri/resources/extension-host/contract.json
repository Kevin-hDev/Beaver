        "name": "subagents.cancel",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "subagents",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["process"],
        "params": [
          {
            "name": "subagentId",
            "type": "string",
            "required": true,
            "limit": "maxIdentifierChars"
          }
        ],
        "result": "subagentMutation"
      },
      {
        "name": "host.load.stage",
        "level": "stable",
        "kind": "notification",
        "rustBudgetMs": null
      }
