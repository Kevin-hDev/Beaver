{
  "apiVersion": "1",
  "capabilities": ["tools", "events"],
  "methods": {
    "coreToHost": ["host.hello", "host.reset", "host.load", "tool.call", "event.emit"],
    "hostToCore": [
      { "name": "app.info", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "sessions.list", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "sessions.get", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "projects.list", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "mcp.connectors.list", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "mcp.tool.call", "level": "stable", "kind": "request", "rustBudgetMs": 25000 },
      { "name": "channels.config.get", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "secrets.provider.get", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "secrets.mcp.oauth.get", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "secrets.mcp.env.get", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "secrets.channel.get", "level": "stable", "kind": "request", "rustBudgetMs": 0 },
      { "name": "host.load.stage", "level": "stable", "kind": "notification", "rustBudgetMs": null }
    ]
  },
  "events": ["session.turn.started"],
  "loadStages": ["import", "activate", "register"],
  "effectClasses": ["read-only", "local-write", "external-read", "external-write", "process", "secret", "unknown"],
  "limits": {
    "maxExtensions": 132,
    "maxUserExtensions": 128,
    "maxTools": 256,
    "maxToolsPerExtension": 64,
    "maxEventsPerExtension": 64,
    "maxPendingRequests": 64,
    "maxInFlightRequests": 64,
    "maxInFlightHandlers": 64,
    "maxWorkingDirectoryChars": 1024,
    "maxGitLocatorChars": 2048,
    "maxNpmSpecChars": 280,
    "maxMessageBytes": 1048576,
    "maxHostProcesses": 32,
    "minLongLivedAppWorkReserve": 96,
    "maxHostRestartsPerWindow": 3,
    "hostRestartWindowSeconds": 300,
    "fingerprintMaxFiles": 2000,
    "fingerprintMaxFileBytes": 4194304,
    "fingerprintMaxTotalBytes": 33554432,
    "fingerprintMaxDepth": 16,
    "maxSessionResults": 500,
    "maxProjectResults": 500,
    "maxPermissionSummaryChars": 512
  },
  "timeouts": {
    "coreRequestTimeoutMs": 30000,
    "mcpToolTimeoutMs": 25000,
    "toolCallTimeoutMs": 55000,
    "hostRequestTimeoutMs": 60000,
    "eventHandlerTimeoutMs": 5000,
    "hostStopTimeoutMs": 5000
  },
  "validation": { "maxNumericLimit": 1073741824 },
  "diagnostics": {
    "hostCodes": ["module_not_found", "syntax_error", "activation_failed", "registration_failed", "import_failed"],
    "runtimeCodes": ["entry_unavailable", "load_failed", "host_missing_response", "advanced_required"]
  },
  "errors": {
    "backendCodes": [
      "extensions_host_unavailable",
      "extensions_host_busy",
      "extensions_host_timeout",
      "extensions_request_too_large",
      "extensions_request_invalid",
      "extensions_tool_unavailable",
      "extensions_tool_arguments_invalid",
      "extensions_builtin_catalog_invalid",
      "extensions_builtin_catalog_unavailable",
      "extensions_builtin_plugin_invalid",
      "extensions_builtin_entry_missing",
      "extensions_builtin_entry_unavailable",
      "extensions_builtin_entry_invalid",
      "extensions_install_failed",
      "extensions_update_failed",
      "extensions_uninstall_failed",
      "extensions_source_invalid",
      "extensions_package_invalid",
      "extensions_git_download_failed",
      "extensions_git_timeout",
      "extensions_runtime_unavailable",
      "extensions_environment_invalid",
      "extensions_dependency_install_failed",
      "extensions_manifest_invalid",
      "extensions_not_beaver_extension",
      "extensions_api_incompatible",
      "extensions_symlink_unsupported",
      "extensions_already_installed",
      "extensions_limit_reached",
      "extensions_storage_failed",
      "extensions_update_identity_changed",
      "extensions_update_unavailable",
      "extensions_cleanup_failed",
      "extensions_operation_failed",
      "extensions_fingerprint_changed",
      "extensions_fingerprint_failed",
      "extensions_stop_unconfirmed",
      "extensions_registry_entry_ignored",
      "extensions_registry_migration_failed",
      "extensions_recovery_marker_invalid",
      "extensions_load_interrupted",
      "extensions_activation_confirmation_required",
      "extensions_not_found",
      "extensions_host_incompatible"
    ],
    "protocolReasons": ["core_busy", "core_request_timeout", "core_transport_failed", "core_method_unavailable", "core_request_failed", "extension_host_busy", "extension_host_request_failed", "extension_host_fatal"]
  }
}
