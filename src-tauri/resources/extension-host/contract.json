        "result": "memoryTopic"
      },
      {
        "name": "memory.write",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "memory",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["local-write"],
        "params": [
          { "name": "scope", "type": "memoryScope", "required": true },
          {
            "name": "topicId",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          },
          {
            "name": "expectedUpdatedAt",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          },
          {
            "name": "content",
            "type": "string",
            "required": true,
            "limit": "maxMessageBytes"
          }
        ],
        "result": "memoryMutation"
      },
      {
        "name": "memory.archive",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "memory",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["local-write"],
        "params": [
          { "name": "scope", "type": "memoryScope", "required": true },
          {
            "name": "topicId",
            "type": "string",
            "required": true,
            "limit": "maxIdentifierChars"
          }
        ],
        "result": "memoryMutation"
      },
      {
        "name": "automations.list",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "automations",
        "requiresContext": true,
        "idempotent": true,
        "effects": ["read-only"],
        "params": [
          {
            "name": "cursor",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          }
        ],
        "result": "automationPage"
      },
      {
        "name": "automations.create",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "automations",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["local-write"],
        "params": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "limit": "maxExtensionNameChars"
          },
          {
            "name": "description",
            "type": "string",
            "required": false,
            "limit": "maxExtensionTextChars"
          },
          {
            "name": "prompt",
            "type": "string",
            "required": true,
            "limit": "maxMessageBytes"
          },
          { "name": "schedule", "type": "object", "required": true }
        ],
        "result": "automation"
      },
      {
        "name": "automations.update",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "automations",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["local-write"],
        "params": [
          {
            "name": "automationId",
            "type": "string",
            "required": true,
            "limit": "maxIdentifierChars"
          },
          { "name": "revision", "type": "integer", "required": true },
          {
            "name": "name",
            "type": "string",
            "required": false,
            "limit": "maxExtensionNameChars"
          },
          {
            "name": "description",
            "type": "string",
            "required": false,
            "limit": "maxExtensionTextChars"
          },
          {
            "name": "prompt",
            "type": "string",
            "required": false,
            "limit": "maxMessageBytes"
          },
          { "name": "schedule", "type": "object", "required": false }
        ],
        "result": "automation"
      },
      {
        "name": "automations.setActive",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "automations",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["local-write", "process"],
        "params": [
          {
            "name": "automationId",
            "type": "string",
            "required": true,
            "limit": "maxIdentifierChars"
          },
          { "name": "revision", "type": "integer", "required": true },
          { "name": "active", "type": "boolean", "required": true }
