        "name": "mcp.tool.call",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 25000,
        "idempotent": false
      },
      {
        "name": "channels.config.get",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "idempotent": true
      },
      {
        "name": "secrets.provider.get",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "idempotent": true
      },
      {
        "name": "secrets.mcp.oauth.get",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "idempotent": true
      },
      {
        "name": "secrets.mcp.env.get",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "idempotent": true
      },
      {
        "name": "secrets.channel.get",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "idempotent": true
      },
      {
        "name": "models.list",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "models",
        "requiresContext": false,
        "idempotent": true,
        "effects": ["read-only"],
        "params": [
          {
            "name": "connectionId",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          },
          {
            "name": "cursor",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          }
        ],
        "result": "modelPage"
      },
      {
        "name": "models.generate",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 25000,
        "capability": "models",
        "requiresContext": true,
        "idempotent": false,
        "effects": ["external-write", "process"],
        "params": [
          {
            "name": "prompt",
            "type": "string",
            "required": true,
            "limit": "maxModelPromptBytes"
          },
          {
            "name": "connectionId",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          },
          {
            "name": "modelId",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          },
          {
            "name": "maxOutputTokens",
            "type": "integer",
            "required": false,
            "limit": "maxModelOutputTokens"
          }
        ],
        "result": "modelGeneration"
      },
      {
        "name": "memory.list",
        "level": "stable",
        "kind": "request",
        "rustBudgetMs": 0,
        "capability": "memory",
        "requiresContext": true,
        "idempotent": true,
        "effects": ["read-only"],
        "params": [
          { "name": "scope", "type": "memoryScope", "required": true },
          {
            "name": "cursor",
            "type": "string",
            "required": false,
            "limit": "maxIdentifierChars"
          }
        ],
        "result": "memoryPage"
