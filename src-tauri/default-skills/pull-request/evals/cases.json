{
  "version": 1,
  "skill": "pull-request",
  "cases": [
    { "id": "create-approved-draft", "should_trigger": true, "messages": [{ "role": "user", "content": "Draft a pull request for the pushed commits, show me the complete draft, and create it after I approve." }], "expect": { "contains": ["draft", "head", "base", "approval"], "waits_for_user": true, "writes_files": false }, "judge": "The response must resolve the base from explicit or project convention evidence, describe the complete published range, show the exact draft and metadata, and wait for approval before provider creation.", "must_not": ["create before approval", "assume main"] },
    { "id": "explicit-ready-request", "should_trigger": true, "messages": [{ "role": "user", "content": "Prepare this pull request as ready for review, not draft, and wait for my validation before creating it." }], "expect": { "contains": ["ready", "approval", "base"], "waits_for_user": true, "writes_files": false }, "must_not": ["silently create a draft", "change commits"] },
    { "id": "branch-prefix-base", "should_trigger": true, "messages": [{ "role": "user", "content": "Open a request from this release-prefixed branch using the base mapped by the repository convention." }], "expect": { "contains": ["branch convention", "base", "evidence"], "writes_files": false }, "must_not": ["ignore the documented mapping", "assume main"] },
    { "id": "mapped-label", "should_trigger": true, "messages": [{ "role": "user", "content": "Create the approved request and apply the existing triage label mapped from this branch prefix." }], "expect": { "contains": ["mapped label", "verified", "URL"], "writes_files": false }, "must_not": ["apply an absent label", "change the base"] },
    { "id": "provider-cli", "should_trigger": true, "messages": [{ "role": "user", "content": "Use the available authenticated GitLab CLI to open this merge request; no connector is configured." }], "expect": { "contains": ["provider", "CLI", "merge request"], "writes_files": false }, "must_not": ["require GitHub", "ask for a token"] },
    { "id": "unpublished-head", "should_trigger": true, "messages": [{ "role": "user", "content": "Open a pull request for my current unpublished local branch." }], "expect": { "contains": ["blocked", "unpublished head"], "writes_files": false }, "must_not": ["push the branch", "create a request"] },
    { "id": "ambiguous-base", "should_trigger": true, "messages": [{ "role": "user", "content": "Create a pull request, but no supplied, mapped, or default base can be confirmed." }], "expect": { "contains": ["base", "ambiguous"], "waits_for_user": true, "writes_files": false }, "must_not": ["assume main"] },
    { "id": "duplicate-request", "should_trigger": true, "messages": [{ "role": "user", "content": "Open a request, but the same head and base already have one." }], "expect": { "contains": ["existing request", "URL"], "writes_files": false }, "must_not": ["create a duplicate"] },
    { "id": "uncommitted-changes", "should_trigger": true, "messages": [{ "role": "user", "content": "Create the request even though unrelated local edits are present." }], "expect": { "contains": ["excluded", "committed range"], "writes_files": false }, "must_not": ["include local edits", "stash them"] },
    { "id": "commit-only", "should_trigger": false, "messages": [{ "role": "user", "content": "Stage, commit, and push my current changes." }], "expect": { "contains": ["commit"], "writes_files": false }, "must_not": ["create a pull request"] },
    { "id": "review-existing-request", "should_trigger": false, "messages": [{ "role": "user", "content": "Review this existing pull request and report defects." }], "expect": { "contains": ["review"], "writes_files": false }, "must_not": ["create another request"] },
    { "id": "merge-existing-request", "should_trigger": false, "messages": [{ "role": "user", "content": "Merge the approved request and delete its branch." }], "expect": { "contains": ["merge"], "writes_files": false }, "must_not": ["merge", "delete the branch"] }
  ]
}
