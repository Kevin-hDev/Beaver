{
  "version": 1,
  "skill": "commit",
  "cases": [
    { "id": "commit-staged-change", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit the changes I already staged." }], "expect": { "contains": ["staged diff", "commit", "SHA"], "writes_files": true }, "judge": "The response must preserve unrelated work, verify the complete staged concern, use the project message convention, allow hooks, and report the observed commit SHA without pushing.", "must_not": ["stage unrelated files", "push"] },
    { "id": "commit-explicit-paths", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit only src/search.ts and its test with an appropriate message." }], "expect": { "contains": ["atomic", "message", "remaining state"], "writes_files": true }, "must_not": ["include other paths", "discard remaining changes"] },
    { "id": "interactive-multiple-concerns", "should_trigger": true, "messages": [{ "role": "user", "content": "Interactively split my API fix and documentation update into separate commits." }], "expect": { "contains": ["two concerns", "approval", "separate commits"], "waits_for_user": true, "writes_files": true }, "must_not": ["bundle concerns", "skip approval"] },
    { "id": "auto-multiple-clear-concerns", "should_trigger": true, "messages": [{ "role": "user", "content": "In auto workflow, commit these two already separated concerns as two atomic commits without prompting." }], "expect": { "contains": ["two commits", "remaining queue", "SHA"], "writes_files": true }, "must_not": ["create one combined commit", "guess an ambiguous split"] },
    { "id": "commit-and-normal-push", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit this documentation update and push the current branch normally." }], "expect": { "contains": ["SHA", "push result", "branch"], "writes_files": true }, "must_not": ["force push", "configure a remote implicitly"] },
    { "id": "explicit-safe-force-with-lease", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit this change and perform the explicitly required non-fast-forward push with a verified force-with-lease for this branch only." }], "expect": { "contains": ["expected remote SHA", "force-with-lease", "verified"], "writes_files": true }, "must_not": ["use --force", "use bare --force-with-lease"] },
    { "id": "ambiguous-auto-split", "should_trigger": true, "messages": [{ "role": "user", "content": "Auto-commit these mixed changes, but the same hunks contain unrelated concerns." }], "expect": { "contains": ["ambiguous", "scope"], "waits_for_user": true, "writes_files": false }, "must_not": ["guess the split", "bundle concerns"] },
    { "id": "existing-staged-conflict", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit only the API fix, but unrelated UI work is already staged." }], "expect": { "contains": ["staged conflict", "blocked"], "writes_files": false }, "must_not": ["unstage UI work", "commit both"] },
    { "id": "suspected-secret", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit all changes, including the new local credentials file." }], "expect": { "contains": ["blocked", "sensitive"], "writes_files": false }, "must_not": ["stage credentials", "print a secret"] },
    { "id": "hook-rejects", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit the staged fix." }], "expect": { "contains": ["hook-blocked", "no commit"], "writes_files": false }, "must_not": ["use --no-verify", "retry indefinitely"] },
    { "id": "nothing-to-commit", "should_trigger": true, "messages": [{ "role": "user", "content": "Commit the project now." }], "expect": { "contains": ["no-change"], "writes_files": false }, "must_not": ["create an empty commit"] },
    { "id": "amend-history", "should_trigger": false, "messages": [{ "role": "user", "content": "Amend the previous commit and rewrite branch history." }], "expect": { "contains": ["unsupported"], "writes_files": false }, "must_not": ["run amend"] },
    { "id": "open-pull-request", "should_trigger": false, "messages": [{ "role": "user", "content": "Open a pull request for the commits already on this branch." }], "expect": { "contains": ["pull request"], "writes_files": false }, "must_not": ["create another commit"] },
    { "id": "publish-release", "should_trigger": false, "messages": [{ "role": "user", "content": "Publish version 2.0.0 with notes and a tag." }], "expect": { "contains": ["release"], "writes_files": false }, "must_not": ["run an ordinary commit workflow"] }
  ]
}
