{
  "version": 1,
  "skill": "repo-setup",
  "cases": [
    { "id": "initialize-local-only", "should_trigger": true, "messages": [{ "role": "user", "content": "Initialize this directory as a Git repository, but do not generate files, commit, or publish." }], "expect": { "contains": ["initialized", "branch", "untracked"], "writes_files": true }, "must_not": ["create an empty commit", "create CONTRIBUTING.md"] },
    { "id": "initialize-explicit-branch", "should_trigger": true, "messages": [{ "role": "user", "content": "Set up Git here with trunk as the initial branch." }], "expect": { "contains": ["trunk", "repository root"], "writes_files": true }, "must_not": ["use main", "commit files"] },
    { "id": "explicit-contributing", "should_trigger": true, "messages": [{ "role": "user", "content": "Initialize the repo and add the bundled contribution guide, but do not publish." }], "expect": { "contains": ["CONTRIBUTING.md", "requested"], "writes_files": true }, "must_not": ["leave {{PROJECT_NAME}}", "overwrite an existing guide"] },
    { "id": "explicit-bootstrap", "should_trigger": true, "messages": [{ "role": "user", "content": "Initialize this empty repository and create a pushable bootstrap commit without staging existing files." }], "expect": { "contains": ["bootstrap", "SHA", "remaining untracked"], "writes_files": true }, "must_not": ["stage existing project content", "create two commits"] },
    { "id": "end-to-end-publish", "should_trigger": true, "messages": [{ "role": "user", "content": "Initialize this directory, create the minimum bootstrap commit, publish a private remote, and push the initial branch." }], "expect": { "contains": ["bootstrap", "private", "remote URL", "remote SHA"], "writes_files": true }, "judge": "The response must complete initialization, the explicitly required minimum bootstrap, private remote creation, attachment, normal push, and remote SHA verification as separately reported outcomes.", "must_not": ["make it public", "force push"] },
    { "id": "provider-cli-available", "should_trigger": true, "messages": [{ "role": "user", "content": "Publish through the authenticated provider CLI that is available; no connector is configured." }], "expect": { "contains": ["provider", "CLI", "remote URL"], "writes_files": true }, "must_not": ["claim a connector is required", "ask for a token"] },
    { "id": "already-repository", "should_trigger": true, "messages": [{ "role": "user", "content": "Initialize Git in this existing repository only." }], "expect": { "contains": ["already-initialized"], "writes_files": false }, "must_not": ["reinitialize", "change the branch"] },
    { "id": "nested-repository", "should_trigger": true, "messages": [{ "role": "user", "content": "Set up this folder even though it contains another repository." }], "expect": { "contains": ["nested repository", "blocked"], "writes_files": false }, "must_not": ["absorb nested Git metadata"] },
    { "id": "normal-commit", "should_trigger": false, "messages": [{ "role": "user", "content": "Commit the staged changes with a conventional message." }], "expect": { "contains": ["commit"], "writes_files": false }, "must_not": ["run repository setup"] },
    { "id": "clone-repository", "should_trigger": false, "messages": [{ "role": "user", "content": "Clone this repository into my workspace." }], "expect": { "contains": ["clone"], "writes_files": false }, "must_not": ["initialize an empty repo"] },
    { "id": "open-review-request", "should_trigger": false, "messages": [{ "role": "user", "content": "Open a draft review request for this already published branch." }], "expect": { "contains": ["review request"], "writes_files": false }, "must_not": ["initialize another repository"] }
  ]
}
